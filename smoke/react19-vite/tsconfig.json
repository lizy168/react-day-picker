{
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["react", "react-dom"],
    "skipLibCheck": false,
    "noEmit": true
  },
  "include": ["src"]
}
